ENVIRONMENT=DEV
DEBUG=True
BACKEND_SERVER_HOST=127.0.0.1
BACKEND_SERVER_PORT=8000
BACKEND_SERVER_WORKERS=4

# Database - Postgres
POSTGRES_DB=my_db
POSTGRES_PASSWORD=postgres13240!
POSTGRES_PORT=5432
POSTGRES_SCHEMA=postgresql
POSTGRES_USERNAME=postgres
IS_ALLOWED_CREDENTIALS=True
API_TOKEN=YOUR-API-TOKEN
AUTH_TOKEN=YOUR-AUTHENTICATION-TOKEN

# This is the host for Docker Postgres Image in docker-compose.yaml
POSTGRES_HOST=db
POSTGRES_URI={POSTGRES_SCHEMA}://{POSTGRES_USERNAME}:{POSTGRES_PASSWORD}@{POSTGRES_HOST}:{POSTGRES_PORT}/{POSTGRES_DB}

# Database - SQLAlchemy
DB_TIMEOUT=5
DB_POOL_SIZE=100
DB_MAX_POOL_CON=80
DB_POOL_OVERFLOW=20
IS_DB_ECHO_LOG=True
IS_DB_EXPIRE_ON_COMMIT=False
IS_DB_FORCE_ROLLBACK=True

# JWT Token
JWT_SECRET_KEY=YOUR-JWT-SECRET-KEY # openssl rand -hex 32
JWT_SUBJECT=YOUR-JWT-SUBJECT
JWT_TOKEN_PREFIX=YOUR-TOKEN-PREFIX
JWT_ALGORITHM=HS256
JWT_MIN=60
JWT_HOUR=23
JWT_DAY=6

# Hash Functions
HASHING_ALGORITHM_LAYER_1=bcrypt
HASHING_ALGORITHM_LAYER_2=argon2
HASHING_SALT=YOUR-RANDOM-SALTY-SALT # openssl rand -hex 32

# Codecov (Login to COdecov and get your TOKEN)
CODECOV_TOKEN=

# Encryption (Fernet urlsafe base64 32-byte key) - protects Razorpay tokens at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-this-fernet-key

# Razorpay Partner OAuth application
RAZORPAY_CLIENT_ID=change-this-client-id
RAZORPAY_CLIENT_SECRET=change-this-client-secret
RAZORPAY_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/onboard-business/callback
RAZORPAY_OAUTH_SCOPE=read_write
RAZORPAY_OAUTH_MODE=test
RAZORPAY_AUTH_BASE_URL=https://auth.razorpay.com
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_WEBHOOK_URL=http://127.0.0.1:8000/api/webhooks/razorpay
RAZORPAY_WEBHOOK_ALERT_EMAIL=
RAZORPAY_WEBHOOK_SECRET=change-this-webhook-secret
RAZORPAY_WEBHOOK_REJECT_UNVERIFIED=False

# Redis (Celery broker) - use `redis` as host inside docker-compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery / recovery-case priority queue
# CELERY_BROKER_URL_OVERRIDE=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
WEBHOOK_QUEUE_NAME=webhook_agent
WEBHOOK_MAX_PROCESSING_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_SECONDS=5
WEBHOOK_RETRY_MAX_DELAY_SECONDS=600
WEBHOOK_STUCK_AFTER_SECONDS=900
WEBHOOK_RECONCILE_INTERVAL_SECONDS=60
WEBHOOK_PRIORITY_AGING_STEP_SECONDS=120
WEBHOOK_DB_WRITE_MAX_RETRIES=3

# Number of parallel agent workers (docker-compose `celery_worker --concurrency`).
# Each case is claimed by exactly one worker, so this is safe to scale up.
CELERY_WORKER_CONCURRENCY=4

# LangGraph recovery agent
OPENAI_API_KEY=change-this-openai-api-key
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT_SECONDS=60
DEFAULT_CUSTOMER_TIMEZONE=UTC

# Razorpay MCP server (https://razorpay.com/docs/mcp-server/)
RAZORPAY_MCP_SERVER_URL=https://mcp.razorpay.com/mcp
RAZORPAY_MCP_TRANSPORT=streamable_http
# DEMO FALLBACK ONLY - Razorpay's legacy Key ID/Secret pair, used to
# authenticate MCP when a business has no OAuth token yet so the agent can be
# demoed end-to-end. Never rely on this in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo stand-in for outreach tools (call/SMS/WhatsApp/email/push) - see /simulation-api
SIMULATION_API_BASE_URL=http://localhost:8001/api/v1
SIMULATION_API_TIMEOUT_SECONDS=10

# Business dashboard (frontend-demo) - the OAuth callback redirects here
FRONTEND_BASE_URL=http://localhost:5173

# Drop-off detection (Razorpay has no order.created/drop-off webhook - polls
# GET /v1/orders per business instead, one at a time on a rotation)
DROPOFF_SWEEP_INTERVAL_SECONDS=60
DROPOFF_POLL_INTERVAL_SECONDS=900
DROPOFF_POLL_JITTER_SECONDS=60
DROPOFF_THRESHOLD_SECONDS=900
DROPOFF_LOOKBACK_SECONDS=3600
DROPOFF_POLL_BATCH_SIZE=20
DROPOFF_MAX_ORDERS_PER_BUSINESS=500
