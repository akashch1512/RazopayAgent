# Copy this file to .env, replace every change-me value, then run:
# docker compose up --build

ENVIRONMENT=DEV
DEBUG=True

# Host-published ports. Container-to-container URLs are overridden by Compose.
BACKEND_PORT=8000
SIMULATION_API_PORT=8001
FRONTEND_PORT=5173

# Backend server
BACKEND_SERVER_HOST=0.0.0.0
BACKEND_SERVER_PORT=8000
BACKEND_SERVER_WORKERS=1

# PostgreSQL
POSTGRES_NAME=razopay_agent
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SCHEMA=postgresql+asyncpg

# Database / auth settings
DB_TIMEOUT=5
DB_POOL_SIZE=10
DB_MAX_POOL_CON=20
DB_POOL_OVERFLOW=20
IS_DB_ECHO_LOG=False
IS_DB_EXPIRE_ON_COMMIT=False
IS_DB_FORCE_ROLLBACK=False
IS_ALLOWED_CREDENTIALS=True
API_TOKEN=change-me-api-token
AUTH_TOKEN=change-me-auth-token

# JWT
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_SUBJECT=razopay-agent
JWT_TOKEN_PREFIX=Bearer
JWT_ALGORITHM=HS256
JWT_MIN=60
JWT_HOUR=23
JWT_DAY=6

# Password hashing
HASHING_ALGORITHM_LAYER_1=bcrypt
HASHING_ALGORITHM_LAYER_2=argon2
HASHING_SALT=change-me-generate-with-openssl-rand-hex-32

# Fernet encryption key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key

# Razorpay Partner OAuth
RAZORPAY_CLIENT_ID=change-me-client-id
RAZORPAY_CLIENT_SECRET=change-me-client-secret
RAZORPAY_OAUTH_REDIRECT_URI=http://localhost:8000/api/onboard-business/callback
RAZORPAY_OAUTH_SCOPE=read_write
RAZORPAY_OAUTH_MODE=test
RAZORPAY_AUTH_BASE_URL=https://auth.razorpay.com
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_WEBHOOK_URL=http://localhost:8000/api/webhooks/razorpay
RAZORPAY_WEBHOOK_ALERT_EMAIL=
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret
RAZORPAY_WEBHOOK_REJECT_UNVERIFIED=False

# Razorpay MCP. Leave the key pair empty when using per-business OAuth.
RAZORPAY_MCP_SERVER_URL=https://mcp.razorpay.com/mcp
RAZORPAY_MCP_TRANSPORT=streamable_http
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL_OVERRIDE=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
WEBHOOK_QUEUE_NAME=webhook_agent
WEBHOOK_MAX_PROCESSING_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_SECONDS=5
WEBHOOK_RETRY_MAX_DELAY_SECONDS=600
WEBHOOK_STUCK_AFTER_SECONDS=900
WEBHOOK_RECONCILE_INTERVAL_SECONDS=60
WEBHOOK_PRIORITY_AGING_STEP_SECONDS=120
WEBHOOK_DB_WRITE_MAX_RETRIES=3
CELERY_WORKER_CONCURRENCY=4

# LangGraph recovery agent
OPENAI_API_KEY=change-me-openai-api-key
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT_SECONDS=60
DEFAULT_CUSTOMER_TIMEZONE=UTC

# Demo services. These URLs are for the backend container; the browser uses localhost.
SIMULATION_API_BASE_URL=http://simulation_api:8001/api/v1
SIMULATION_API_TIMEOUT_SECONDS=10
FRONTEND_BASE_URL=http://localhost:5173

# Drop-off polling
DROPOFF_SWEEP_INTERVAL_SECONDS=60
DROPOFF_POLL_INTERVAL_SECONDS=900
DROPOFF_POLL_JITTER_SECONDS=60
DROPOFF_THRESHOLD_SECONDS=900
DROPOFF_LOOKBACK_SECONDS=3600
DROPOFF_POLL_BATCH_SIZE=20
DROPOFF_MAX_ORDERS_PER_BUSINESS=500
