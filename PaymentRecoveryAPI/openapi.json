    "/api/recovery-cases/{case_id}/retry": {
      "post": {
        "tags": [
          "recovery-cases"
        ],
        "summary": "Recovery-Cases:Retry",
        "description": "Manually reopen a `DEAD` or `FAILED` case and dispatch it again - for a\nhuman who just fixed the underlying issue (or wants another shot) rather\nthan waiting on the reconciler's own backoff/aging.",
        "operationId": "recovery_cases_retry_api_recovery_cases__case_id__retry_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
