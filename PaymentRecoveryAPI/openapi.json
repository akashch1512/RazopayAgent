      "get": {
        "tags": [
          "recovery-cases"
        ],
        "summary": "Recovery-Cases:Get-By-Id",
        "description": "One merged case plus its full delivery history (oldest first) - what an\nagent, a support view, or a debugging session needs to see \"what happened\".",
