    "/api/recovery-cases/": {
      "get": {
        "tags": [
          "recovery-cases"
        ],
        "summary": "Recovery-Cases:List",
        "description": "Every recovery case, most recently active first - an ops/support dashboard's\nmain query. Optionally narrow by `business_id` and/or `status` (e.g.\n`?status=DEAD` to find cases that need a human).",
