    "/api/webhooks/razorpay": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Webhooks:Razorpay",
        "description": "Single ingress for every onboarded business' Razorpay webhooks.\n\nFast path: verify signature, normalize the envelope, merge it into its\nrecovery case (same order / same entity -> same case, so a customer\nretrying a failing payment N times is one unit of agent work, not N),\npersist the delivery as history, dispatch the case by priority, return 200.",
        "operationId": "webhooks_razorpay_api_webhooks_razorpay_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Webhooks Razorpay Api Webhooks Razorpay Post"
                }
              }
            }
          }
        }
      }
    }
  },
