# Copy to .env and fill in. Loaded by docker-compose.yml (env_file) and by
# pydantic-settings. Each line is VAR=value - inline "# comments" are NOT
# supported by the compose env-file parser, so keep notes on their own lines.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# ENVIRONMENT: DEV | STAGE | PROD
ENVIRONMENT=PROD
# Host port the API is published on.
BACKEND_PORT=8000
# Parallel agent runs per worker container.
CELERY_WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# PostgreSQL - runs OUTSIDE this stack
# ---------------------------------------------------------------------------
# Managed/remote DB: set POSTGRES_HOST to its hostname.
# Postgres on this same machine: keep host.docker.internal.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_NAME=razopay_agent
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Redis - provided by this stack; host is forced to "redis" by compose.
# ---------------------------------------------------------------------------
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Fernet key (encrypts Razorpay tokens at rest). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Signs the onboarding OAuth `state` token.
JWT_SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# LangGraph recovery agent
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Razorpay Partner integration
# ---------------------------------------------------------------------------
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
# RAZORPAY_OAUTH_MODE: test | live
RAZORPAY_OAUTH_MODE=live
RAZORPAY_OAUTH_REDIRECT_URI=https://your-domain/api/integrations/razorpay/callback
RAZORPAY_WEBHOOK_URL=https://your-domain/api/webhooks/razorpay
RAZORPAY_WEBHOOK_ALERT_EMAIL=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_REJECT_UNVERIFIED=false
# DEMO ONLY - legacy key pair, lets the agent hit Razorpay before OAuth onboarding.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Frontends / demo services
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=https://your-dashboard
SIMULATION_API_BASE_URL=http://localhost:8001/api/v1
# CORS allow-list (JSON array). Uncomment to restrict.
# ALLOWED_ORIGINS=["https://your-dashboard"]
